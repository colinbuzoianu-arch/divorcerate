# CoupleIQ / splitornot.com — local environment
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
#
# NOTE: the values below are non-secret placeholders written so GitHub secret
# scanning does not flag them. Replace the angle-bracket text with real values.

# --- AI analysis (Anthropic Messages API) ---
# Server-only. Used by app/api/analyze/route.ts.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# --- Payments (Stripe Checkout) ---
# Server-only. Used by app/api/checkout and app/api/verify-payment.
STRIPE_SECRET_KEY=<your-stripe-secret-key>
# The Price ID of the paid report product in the Stripe dashboard.
STRIPE_PRICE_ID=<your-stripe-price-id>
# The Price ID of the couple-comparison product (Phase 6.2). Until this is set,
# the "unlock comparison" button shows "launching soon" instead of charging.
STRIPE_COMPARISON_PRICE_ID=<your-stripe-comparison-price-id>
# Signing secret of the Stripe webhook (Event destination) that sends
# `checkout.session.completed` to /api/stripe/webhook. From the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>

# --- Result storage + rate limiting (Upstash Redis) ---
# Server-only. Provisioned via the Vercel Marketplace (Upstash). Read by
# Redis.fromEnv() in lib/kv.ts and lib/ratelimit.ts.
UPSTASH_REDIS_REST_URL=<your-upstash-redis-rest-url>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-redis-rest-token>

# --- App URL ---
# Public base URL, used for building absolute links / Stripe redirect URLs.
# Local: http://localhost:3000  ·  Production: https://splitornot.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) ---
# Server-only. Used by app/api/email-capture/route.ts.
RESEND_API_KEY=<your-resend-api-key>
# Verified sender address. Falls back to onboarding@resend.dev if unset.
RESEND_FROM_EMAIL=CoupleIQ <hello@splitornot.com>
# Resend audience (contacts list) ID. Optional; contact add is best-effort.
RESEND_AUDIENCE_ID=<your-resend-audience-id>
